<UserControl x:Class="AutoCommand.Views.ShieldsUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Status chips reuse the app's accent brushes; amber = open door,
             green = closed, red = needs attention (tamper, hijack). -->
        <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="BadBrush" Color="#F87171"/>

        <!-- Rail nav row: the checklist + the four rituals, one question per
             row. Mirrors the app-wide sidebar TabItem (indicator bar, nav
             brushes) sized for the inner rail. The header's Grid pins the
             status dot to the row's right edge in both rail states; padding
             tightens when the rail collapses so icon + dot still fit. -->
        <Style x:Key="RailItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,0,6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <Grid>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                <Border x:Name="indicator" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Margin="-12,-9,0,-9" Background="{DynamicResource TabIndicatorGradientBrush}"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Padding" Value="6,9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rail labels and rail chrome hide when the rail collapses — the
             same pattern as MainWindow's NavPaneLabel / IsPaneCollapsed. -->
        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailExpand" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailMeta" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The Shields Up rail: a NavigationView inside the sidebar. Left
             column = THE RITUAL header, the five nav rows, then a dot legend
             and the collapse toggle; right column = the intro line above the
             selected section. -->
        <Style x:Key="RailControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="212"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Width" Value="56"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="12,10,10,6">
                                        <TextBlock Text="THE RITUAL" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Style="{StaticResource RailMeta}"/>
                                        <TextBlock Text="run top-down · one question per step" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Margin="0,3,0,0" Style="{StaticResource RailMeta}"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0" Padding="10,8">
                                        <StackPanel>
                                            <!-- dot legend: the same language as the checklist chips -->
                                            <StackPanel Style="{StaticResource RailMeta}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="closed / done" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentAmberBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="open / not set" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="needs attention" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Click="RailCollapseBtn_Click" HorizontalAlignment="Stretch" Padding="8,5"
                                                    FontSize="11" Margin="0,8,0,0" ToolTip="Show / hide rail labels">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="«  Collapse" Style="{StaticResource RailLabel}"/>
                                                    <TextBlock Text="»" Style="{StaticResource RailExpand}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,4,0,0"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Margin="4,2,8,10"
                                               Text="The fresh-install ritual, folded into AutoCommand: close the doors Windows leaves open, silence the phone-home, take the junk out, and set the OS switches. Every action asks first, almost every action reverses. The firewall profile lives in the Firewall tab. The dots on the rail mirror each section's live state."/>
                                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,12">
        <TabControl x:Name="SubTabs" Style="{StaticResource RailControl}"
                    SelectionChanged="SubTabs_SelectionChanged">

            <!-- ═══════════ QUICK SCAN ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✅" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Quick Scan" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="QuickScanDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,14,4,8">

                        <!-- ── migration banner (visible only when the standalone app left state) ── -->
                        <Border x:Name="MigrationBanner" Visibility="Collapsed" CornerRadius="12"
                                Background="{DynamicResource BadgeAmberBg}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="MigrationText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ImportBtn" Content="Import Shields Up state"
                                            Click="ImportBtn_Click" Padding="12,5"/>
                                    <TextBlock x:Name="MigrationResultText" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionHeader}" Text="QUICK SCAN"/>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="The whole ritual as one checklist. It reads your machine's current state first — what is already done shows in green — and finishes the rest in order, with one master confirmation. Each step's manual control lives in its own sub-tab."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="QuickScanBtn" Style="{DynamicResource PrimaryButton}"
                                            Content="Run Quick Scan" Click="QuickScanBtn_Click"/>
                                    <Button x:Name="QuickScanCheckBtn" Content="Re-check status" Margin="12,0,0,0"
                                            Padding="14,8" Click="QuickScanCheckBtn_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="QuickScanList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="260"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Chip}" FontSize="13" VerticalAlignment="Top"
                                                           Foreground="{Binding ChipBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="QuickScanProgress" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ DOORS ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🚪" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Doors" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="DoorsDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,14,4,8">
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionHeader}" Text="CLOSE THE DOORS"/>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Built-in remote-access plumbing most people never use. Re-checked live every time this tab opens."/>
                                <Button x:Name="DoorsRefreshBtn" Content="Re-check doors" Padding="12,5" Margin="0,0,0,10"
                                        Click="DoorsRefreshBtn_Click"/>

                                <TextBlock Text="SSTP VPN service &amp; miniports" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SstpStatusText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Button x:Name="SstpToggleBtn" Grid.Column="1" Content="Disable + neuter miniports"
                                            Padding="12,5" Margin="12,0,0,0" Click="SstpToggleBtn_Click"/>
                                </Grid>

                                <TextBlock Text="Wi-Fi Direct ghost hotspot" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HostedNetworkStatusText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="HostedStopBtn" Content="Stop &amp; disallow" Padding="12,5"
                                                Margin="12,0,0,0" Click="HostedStopBtn_Click"/>
                                        <Button x:Name="WifiDirectRemoveBtn" Content="Remove adapter(s)" Padding="12,5"
                                                Margin="8,0,0,0" Click="WifiDirectRemoveBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Kernel debug (KDNET)" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="KdnetStatusText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button x:Name="KdnetToggleBtn" Grid.Column="1" Content="Turn debug off"
                                            Padding="12,5" Margin="12,0,0,0" Click="KdnetToggleBtn_Click"/>
                                </Grid>

                                <TextBlock Text="Windows VPN services (RasMan, IKEEXT, PolicyAgent, RemoteAccess)" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="VpnStatusText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="VpnDisableBtn" Content="Disable all" Padding="12,5"
                                                Margin="12,0,0,0" Click="VpnDisableBtn_Click"/>
                                        <Button x:Name="VpnEnableBtn" Content="Re-enable" Padding="12,5"
                                                Margin="8,0,0,0" Click="VpnEnableBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="WAN Miniport adapters" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MiniportStatusText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Button x:Name="MiniportRemoveBtn" Grid.Column="1" Content="Remove all" Padding="12,5"
                                            Margin="12,0,0,0" Click="MiniportRemoveBtn_Click"/>
                                </Grid>
                                <TextBlock x:Name="DoorActionResult" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ PRIVACY ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📵" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Privacy" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="PrivacyDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,14,4,8">
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionHeader}" Text="SILENCE THE PHONE-HOME"/>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Flips each vendor's own official opt-out switch, saves the previous setting, then checks the app actually stopped. One click reverts exactly. Optional: pin the domains in the hosts file as a backstop — attempts then land in AutoCommand's sinkhole log."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="TelemetryRefreshBtn" Content="Re-check vendors" Padding="12,5"
                                            Click="TelemetryRefreshBtn_Click"/>
                                    <Button x:Name="TelemetryEnforceAllBtn" Content="Pin remaining (hosts backstop)" Padding="12,5"
                                            Margin="8,0,0,0" Click="TelemetryEnforceAllBtn_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="TelemetryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Evidence}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Content="Opt out" Padding="10,4" Visibility="{Binding OptOutVis}"
                                                            Click="TelemetryOptOut_Click" Tag="{Binding}"/>
                                                    <Button Content="Revert" Padding="10,4" Margin="6,0,0,0" Visibility="{Binding RevertVis}"
                                                            Click="TelemetryRevert_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TelemetryResultText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ JUNK ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🧹" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Junk" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="JunkDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,14,4,8">
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionHeader}" Text="TAKE THE JUNK OUT"/>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Preinstalled apps — games, trial apps, the ones that come back with the update. Nothing Windows needs to run is ever on the list, and you can edit the list in the standalone Shields Up editor before running this."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BloatRefreshBtn" Content="Scan for bloatware" Padding="12,5"
                                            Click="BloatRefreshBtn_Click"/>
                                    <Button x:Name="BloatRemoveBtn" Content="Remove matched apps" Padding="12,5" Margin="8,0,0,0"
                                            Click="BloatRemoveBtn_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BloatListText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Text="Not scanned yet."/>
                                <TextBlock x:Name="BloatResultText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ HARDENING ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔐" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Hardening" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="HardeningDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,14,4,8">
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionHeader}" Text="OS HARDENING"/>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Registry-level switches, each reversible. Reboot after changing IPv6 or LSA."/>

                                <TextBlock Text="IPv6 (global DisabledComponents)" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Ipv6StatusText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button x:Name="Ipv6Btn" Grid.Column="1" Content="Disable" Padding="12,5"
                                            Margin="12,0,0,0" Click="Ipv6Btn_Click"/>
                                </Grid>

                                <TextBlock Text="LSA Protection (RunAsPPL)" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LsaStatusText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button x:Name="LsaBtn" Grid.Column="1" Content="Enable" Padding="12,5"
                                            Margin="12,0,0,0" Click="LsaBtn_Click"/>
                                </Grid>

                                <TextBlock Text="UAC strictness" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UacStatusText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button x:Name="UacBtn" Grid.Column="1" Content="Set maximum" Padding="12,5"
                                            Margin="12,0,0,0" Click="UacBtn_Click"/>
                                </Grid>

                                <TextBlock Text="Hosts file" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HostsStatusText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Button x:Name="HostsResetBtn" Grid.Column="1" Content="Reset to default" Padding="12,5"
                                            Margin="12,0,0,0" Click="HostsResetBtn_Click"/>
                                </Grid>
                                <TextBlock x:Name="HardeningActionResult" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
