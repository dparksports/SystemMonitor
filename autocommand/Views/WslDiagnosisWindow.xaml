<Window x:Class="AutoCommand.Views.WslDiagnosisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Why is WSL offline?" Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🩺 Why is WSL offline?" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button x:Name="RerunBtn" Content="Re-run" Padding="14,6" Margin="16,0,0,0"
                    VerticalAlignment="Center" Click="RerunBtn_Click"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="10" Padding="14" Margin="0,0,0,10"
                Background="{DynamicResource SurfaceAltBrush}">
            <TextBlock x:Name="VerdictText" TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="Checking — host egress, guest probe, rule model, Hyper-V layer…"/>
        </Border>

        <TextBox Grid.Row="2" x:Name="EvidenceText" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 VerticalScrollBarVisibility="Auto"
                 Text="…"/>

        <TextBlock Grid.Row="3" x:Name="NextStepText" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource AccentAmberBrush}" Visibility="Collapsed"/>
    </Grid>
</Window>
