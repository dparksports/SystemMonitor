<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the python instrumentation pair plus the
       payload/embed and real-session TLS decrypt paths. Runs the shipped
       Forensics.Core + Engines.Watch assemblies, never source copies; all
       persistence goes to temp dirs, so a suite never touches real user
       state (manifest, keylog, scan state). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PyTraceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\AutoCommand.Forensics.Core\AutoCommand.Forensics.Core.csproj" />
  </ItemGroup>

</Project>
