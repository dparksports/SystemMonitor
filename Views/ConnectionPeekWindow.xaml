<Window x:Class="AutoCommand.Views.ConnectionPeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Peek" Width="1080" Height="760" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + identity -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Traffic Peek" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="What this connection actually carries — TLS metadata always, plaintext when session keys exist, plus what the hosting service logged around the same moment. Captured only while this window is open; everything stays on this machine."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,0"/>
            <Border Background="{DynamicResource BadgeBlueBg}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                <WrapPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="IdentIpLabel" Text="REMOTE IP" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentIp" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="PROCESS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentProcess" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="HOSTED SERVICES" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentServices" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="HOST" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentHost" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- Status strip -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="CaptureStatusText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Starting capture…"/>
                <TextBlock x:Name="CaptureWarnText" FontSize="11" Foreground="{DynamicResource AccentAmberBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Flows + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="CAPTURED FLOWS (newest first)"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListView x:Name="FlowList" SelectionMode="Single" SelectionChanged="FlowList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="62" DisplayMemberBinding="{Binding TimeDisplay}"/>
                            <GridViewColumn Header="Remote" Width="130" DisplayMemberBinding="{Binding RemoteEndpoint}"/>
                            <GridViewColumn Header="↑" Width="66" DisplayMemberBinding="{Binding UpDisplay}"/>
                            <GridViewColumn Header="↓" Width="66" DisplayMemberBinding="{Binding DownDisplay}"/>
                            <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="SNI" Width="150" DisplayMemberBinding="{Binding SniDisplay}"/>
                            <GridViewColumn Header="Process" Width="130" DisplayMemberBinding="{Binding ProcessDisplay}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                <StackPanel x:Name="DetailPane">
                    <TextBlock Text="SELECTED FLOW" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="DetailWire" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailTls" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailSni" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailApp" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Honest verdict, verbatim from the decryptor -->
                    <Border x:Name="StatusBanner" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <TextBlock x:Name="StatusBannerText" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <!-- How to actually get plaintext: the SSLKEYLOGFILE coverage
                         note, shown only on "encrypted (no keys)" rows -->
                    <TextBlock x:Name="CoverageNoteText" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <!-- Plaintext — only when keys existed -->
                    <StackPanel x:Name="PlaintextSection" Visibility="Collapsed">
                        <TextBlock Text="DECRYPTED CONTENT" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailHttp" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="PlaintextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="230"
                                 Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"/>
                        <Expander Header="Hex view" Margin="0,6,0,0">
                            <TextBox x:Name="HexBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" MaxHeight="200"
                                     Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"/>
                        </Expander>
                    </StackPanel>
                    <!-- Python audit trace — instrumented program-scoped subjects -->
                    <StackPanel x:Name="PythonTraceSection" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="PYTHON AUDIT TRACE (this process)" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                   ToolTip="Call stacks recorded inside the process when a spawn API fired — requires the environment to be instrumented (🐍 Instrument… button)."/>
                        <TextBox x:Name="PythonTraceBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="200"
                                 Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Service activity around the same window -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="SERVICE ACTIVITY IN THIS WINDOW (Windows Update · BITS · Delivery Optimization)"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="↻" Style="{StaticResource PrimaryButton}" Padding="8,1" Margin="8,0,0,0"
                        Click="RefreshEventsBtn_Click" ToolTip="Re-read the service event channels for the current window"/>
            </StackPanel>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <ListView x:Name="EventList" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="62" DisplayMemberBinding="{Binding TimeDisplay}"/>
                            <GridViewColumn Header="Channel" Width="150" DisplayMemberBinding="{Binding ChannelDisplay}"/>
                            <GridViewColumn Header="ID" Width="46" DisplayMemberBinding="{Binding EventId}"/>
                            <GridViewColumn Header="Event" Width="700">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </DockPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="🚀 Launch under watch…" Style="{StaticResource PrimaryButton}" Padding="10,2"
                    Click="LaunchUnderWatchBtn_Click" Margin="0,0,8,0"
                    ToolTip="Start a program with SSLKEYLOGFILE set in its environment only — its TLS traffic decrypts here as it connects"/>
            <Button Content="🐍 Instrument…" Style="{StaticResource PrimaryButton}" Padding="10,2"
                    Click="InstrumentBtn_Click" Margin="0,0,8,0"
                    ToolTip="Opt-in per python environment: install the audit hook that reports spawn stacks and TLS session keys"/>
            <Button Content="📋 Copy report" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="CopyBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="KeylogChip" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="KeylogChip_Click" Margin="0,0,8,0"/>
            <TextBlock Text="Captured and processed on this machine only — nothing is transmitted. Plaintext appears only for apps that log session keys; Windows services never do."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
