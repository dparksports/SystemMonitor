<UserControl x:Class="AutoCommand.Views.SpawnWatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spawn Watches: user-defined name prefilters evaluated at Sysmon
         ingestion time. Everything here reads what SpawnWatchService
         already collected — the service accumulates hits while the tab is
         hidden, so the 10 s refresh loop is safe to visibility-gate. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Spawn Watches" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Name prefilters evaluated the moment Sysmon archives a process — not chased after spawn"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ReplayBtn" Content="⟲ Replay 24 h" Style="{StaticResource PrimaryButton}" Click="ReplayBtn_Click" Margin="0,0,8,0"
                        ToolTip="Re-run every rule over what the archive already holds (last 24 h, deduped) — a new rule lights up history immediately"/>
                <Button x:Name="OpenFolderBtn" Content="📁 Open Folder" Style="{StaticResource PrimaryButton}" Click="OpenFolderBtn_Click" Margin="0,0,8,0"
                        ToolTip="Open the watches directory — rules are JSON files, hand-editing them is supported (picked up on the next pass)"/>
                <Button x:Name="NewRuleBtn" Content="＋ New Rule" Style="{StaticResource PrimaryButton}" Click="NewRuleBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Loading…" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           ToolTip="Rules are matched service-side as events are archived — collection continues while this tab is hidden"/>
                <Border Grid.Column="1" Background="{DynamicResource BadgeBlueBg}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                        ToolTip="Hits recorded over the last 24 hours, all rules together">
                    <TextBlock x:Name="HitsChipText" Text="Hits 24h: 0" Foreground="{DynamicResource AccentBlueBrush}" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- Rule editor (collapsed until New Rule) -->
        <Border x:Name="EditorPanel" Grid.Row="2" Style="{StaticResource CardPanel}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="New spawn watch" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="RuleNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,16,6"
                             ToolTip="Also the rule's file name — letters, digits, space, dash, underscore"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Process" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="RuleProcessBox" Grid.Row="0" Grid.Column="3" Margin="0,0,16,6" Text="*"
                             ToolTip="Image to watch — '*' wildcards, matches leaf name or full path. '*' = any process."/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Parent" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="RuleParentBox" Grid.Row="0" Grid.Column="5" Margin="0,0,16,6"
                             ToolTip="Parent image filter — 'svchost.exe' restricts to service-host spawns. Empty = any parent."/>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Service" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="RuleServiceBox" Grid.Row="0" Grid.Column="7" Margin="0,0,16,6"
                             ToolTip="Restrict to spawns whose parent svchost command line claims this service (-s token). Empty = any."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cmd contains" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="RuleContainsBox" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0"
                             ToolTip="Case-insensitive substring the new process's command line must contain. Empty = any."/>

                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="RuleMinusAllowBox" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                                  Content="minus allowlist" ToolTip="Never count images matching allowlist.txt (one wildcard per line, in the watches folder)"/>
                        <CheckBox x:Name="RuleEnabledBox" IsChecked="True" VerticalAlignment="Center" Content="enabled"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource PrimaryButton}" Click="CancelRuleBtn_Click" Margin="0,0,8,0"/>
                        <Button Content="Save Rule" Style="{StaticResource PrimaryButton}" Click="SaveRuleBtn_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main: rules card (left) + hits grid (right) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="RULES" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- the 'all rules' pseudo-row -->
                            <Border x:Name="AllRulesRow" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                    Cursor="Hand" MouseLeftButtonUp="AllRulesRow_Click">
                                <TextBlock x:Name="AllRulesText" Text="All rules" FontWeight="SemiBold"/>
                            </Border>
                            <ItemsControl x:Name="RulesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RuleRowBorder" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                                Cursor="Hand" MouseLeftButtonUp="RuleRow_Click" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding Watch.Enabled}" VerticalAlignment="Center"
                                                          Checked="RuleEnabled_Changed" Unchecked="RuleEnabled_Changed" Tag="{Binding}"
                                                          ToolTip="Disabled rules stop matching immediately (on the next pass)"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Watch.Name}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource BadgeAmberBg}" CornerRadius="10" Padding="8,2"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        ToolTip="Hits over the last 24 hours">
                                                    <TextBlock Text="{Binding Hits24hText}" Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Grid.Row="0" Grid.Column="3" Content="✕" Width="22" Height="22" Padding="0" FontSize="10"
                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Cursor="Hand" Click="DeleteRuleBtn_Click" Tag="{Binding}"
                                                        ToolTip="Delete this rule (hits already recorded stay on disk)"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding MatchDescription}" FontSize="10" FontFamily="Consolas"
                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="24,4,0,0" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="RuleRowBorder" Property="Background" Value="{DynamicResource BadgeBlueBg}"/>
                                                <Setter TargetName="RuleRowBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HitsHeaderText" Grid.Row="0" Text="HITS — ALL RULES (LAST 24 H)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="HitsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionChanged="HitsGrid_SelectionChanged"
                              SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="80"/>
                            <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="110"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding Image}" Width="2*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                            <DataGridTextColumn Header="Parent" Binding="{Binding Parent}" Width="170"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="70"/>
                            <DataGridTextColumn Header="Command line" Binding="{Binding CmdText}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Detail: the full EventData of the selected hit -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="12" Margin="0,12,0,0" Height="150">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="DetailHeaderText" Text="DETAIL — select a hit" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailText" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
